# Copy to .env and fill in values. Never commit the real .env file.

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sentinelkyc
POSTGRES_USER=sentinelkyc
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://sentinelkyc:change-me@localhost:5432/sentinelkyc
DATABASE_URL_SYNC=postgresql+psycopg2://sentinelkyc:change-me@localhost:5432/sentinelkyc

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Dagster ---
DAGSTER_HOME=/opt/dagster/dagster_home

# --- Security (Phase 4) ---
# Generate JWT keys and random secrets with: uv run python infra/scripts/generate_dev_secrets.py
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
ENCRYPTION_MASTER_KEY=
BLIND_INDEX_KEY=

# Restricted role the running application connects as (never the migration
# superuser); see migration 0004 for the CREATE ROLE and GRANT statements.
APP_DB_USER=sentinelkyc_app
APP_DB_PASSWORD=change-me
APP_DATABASE_URL=postgresql+asyncpg://sentinelkyc_app:change-me@localhost:5432/sentinelkyc
APP_DATABASE_URL_SYNC=postgresql+psycopg2://sentinelkyc_app:change-me@localhost:5432/sentinelkyc

# --- LLM providers (Phase 6) ---
LLM_PRIMARY=groq
GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- OFAC sanctions data source ---
OFAC_SDN_URL=https://sanctionslistservice.ofac.treas.gov/api/PublicationPreview/exports/SDN.XML
OFAC_SDN_ADVANCED_URL=https://sanctionslistservice.ofac.treas.gov/api/PublicationPreview/exports/SDN_ADVANCED.XML
OFAC_CONSOLIDATED_URL=https://sanctionslistservice.ofac.treas.gov/api/PublicationPreview/exports/CONSOLIDATED.XML
OFAC_XSD_URL=https://sanctionslistservice.ofac.treas.gov/api/PublicationPreview/exports/XML.xsd
OFAC_MIN_RECORD_COUNT=10000
OFAC_POLL_INTERVAL_HOURS=6

# --- Embeddings ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_BATCH_SIZE=256

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
